# 셸 스크립트는 반드시 LF로 체크아웃한다.
#
# 왜: Windows 체크아웃에서 git이 CRLF로 변환하면 WSL/Linux bash가 `\r`을 명령의 일부로 읽어
# `$'\r': command not found`, `set: pipefail: invalid option name`으로 죽는다(2026-07-21 실제 발생 —
# server/scripts/deploy.sh가 워크트리에서는 되고 본 리포에서는 안 되던 원인).
*.sh text eol=lf

# 워크플로 스크립트도 LF로. 왜: Windows autocrlf가 CRLF로 바꾸면 Workflow 도구가 을
# 「승인창에 숨는 제어문자」로 보고 실행을 거부한다(2026-09-02 실제 발생 — 워크플로 3개 전부).
.claude/workflows/*.js text eol=lf

# 바이너리 산출물은 diff/머지 대상이 아니다.
*.pdf binary
*.png binary
*.jpg binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.7z  binary
*.exe binary
*.gguf binary

# 사다리 홀드아웃(평가지)은 LF로 고정한다.
#
# 왜: 이 파일의 값어치는 「두 기계가 같은 시험지를 보는가」이고, 그것을 가리는 유일한 자가 **md5**다
# (tools/ladder/README.md 회전 절차 ③). autocrlf=true인 Windows 체크아웃에서 CRLF로 바뀌면
# 같은 내용인데 md5가 달라져, 대조하는 사람이 「파일이 다르다」고 읽는다 — 잣대가 기계에 따라 흔들린다.
# 학습은 gb10(LF)에서 돌므로 내용은 늘 LF가 맞고, 여기서 그것을 못박는다.
tools/team-bench/holdout-vuln-100.json text eol=lf
