# 셸 스크립트는 반드시 LF로 체크아웃한다.
#
# 왜: Windows 체크아웃에서 git이 CRLF로 변환하면 WSL/Linux bash가 `\r`을 명령의 일부로 읽어
# `$'\r': command not found`, `set: pipefail: invalid option name`으로 죽는다(2026-07-21 실제 발생 —
# server/scripts/deploy.sh가 워크트리에서는 되고 본 리포에서는 안 되던 원인).
*.sh text eol=lf

# 워크플로 스크립트도 LF로. 왜: Windows autocrlf가 CRLF로 바꾸면 Workflow 도구가 을
# 「승인창에 숨는 제어문자」로 보고 실행을 거부한다(2026-09-02 실제 발생 — 워크플로 3개 전부).
.claude/workflows/*.js text eol=lf

# 바이너리 산출물은 diff/머지 대상이 아니다.
*.pdf binary
*.png binary
*.jpg binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.7z  binary
*.exe binary
*.gguf binary
