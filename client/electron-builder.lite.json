{
  "appId": "ai.gijo.as.lite",
  "productName": "GIJO AS Lite",
  "icon": "build/icon-lite.png",
  "directories": {
    "output": "release-lite"
  },
  "extraMetadata": {
    "gijoEdition": "lite",
    "productName": "GIJO AS Lite",
    "version": "1.1.9"
  },
  "files": [
    "dist/**/*",
    "src/renderer/**/*",
    "smartmd/**/*"
  ],
  "extraResources": [
    {
      "from": "server-dist",
      "to": "server-dist",
      "filter": [
        "**/*",
        "!**/*.map"
      ]
    },
    {
      "from": "../server/models/bge-m3",
      "to": "server-dist/models/bge-m3"
    }
  ],
  "win": {
    "target": "nsis",
    "extraResources": [
      {
        "from": "build/llama-cuda",
        "to": "server-dist/llama-cuda"
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.business",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "hardenedRuntime": false,
    "identity": null,
    "extraResources": [
      {
        "from": "build/llama-metal",
        "to": "server-dist/llama-metal"
      }
    ]
  },
  "dmg": {
    "title": "${productName} ${version}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "runAfterFinish": true,
    "include": "build/installer.nsh"
  },
  "afterSign": "build/mac-adhoc-sign.cjs"
}
