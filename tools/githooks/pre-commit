#!/bin/sh
# tools/githooks/pre-commit — 개인키가 커밋에 섞여 들어가는 것을 **커밋 순간에** 막는다.
#
# 왜 여기 있나: 2026-08-09 하루에 두 번 발행 개인키가 밖으로 나갔다. 두 번 다
# "대화창에 올리지 않는다"가 문서에 이미 적혀 있었고, 두 번 다 안 지켜졌다.
# 규칙은 사람의 주의력에 기대고, 주의력은 바쁠 때 먼저 떨어진다. 그래서 기계가 막는다.
#
# 왜 .git/hooks가 아니라 tools/githooks인가: .git/hooks는 **git이 추적하지 않는다.**
# 거기 두면 이 기계에만 걸리고 다른 기계·새 체크아웃에는 없다 — 안전망이 한 대에만
# 있는 셈이다. 저장소에 담아 두면 두 기계가 같은 것을 쓴다.
#
# 켜는 법 (기계마다 한 번):
#     git config core.hooksPath tools/githooks
#
# 급할 때 넘기는 법: git commit --no-verify
#   ⚠ 넘긴다는 건 "개인키가 아니라고 내가 확인했다"는 뜻이다. 확인 없이 쓰지 말 것.

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node를 찾지 못해 개인키 검사를 건너뜁니다." >&2
  exit 0
fi

node tools/keyleak-check.mjs --quiet
if [ $? -ne 0 ]; then
  echo "" >&2
  echo "━━ 커밋을 막았습니다 — 개인키가 새기 쉬운 자리에 있습니다 ━━" >&2
  echo "   위 경로를 D:\\GIJO-AS-signing (또는 오프라인 매체)로 옮기고 다시 커밋하세요." >&2
  echo "   이미 첨부·공유한 적이 있으면 옮기는 것만으론 부족합니다 — 키를 갈아야 합니다." >&2
  echo "" >&2
  exit 1
fi

exit 0
