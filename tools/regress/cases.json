{
  "comment": "디스패치 답변 회귀 케이스 — 실 서버(/api/dispatch)에 던져 결정적 패턴으로 검사한다. expect=반드시 포함(정규식, 하나라도), forbid=포함되면 실패(정규식), signals=응답 필드 검사. 근거: 2026-07-25 RAG 시드 인입+그라운딩 강화로 교정 검증된 사실들 — 이 케이스들이 깨지면 모델/프롬프트/RAG 변경이 회귀를 일으킨 것.",
  "cases": [
    {
      "id": "fin-mangbunri",
      "q": "금융권 망분리 의무의 법적 근거 규정은 무엇이야?",
      "expect": [
        "전자금융감독규정"
      ],
      "forbid": [
        "정보통신망법\\s*제\\s*12\\s*조"
      ]
    },
    {
      "id": "log4shell-rce",
      "q": "CVE-2021-44228 Log4Shell은 정보유출 취약점이야 원격코드실행이야?",
      "expect": [
        "원격\\s*코드\\s*실행|RCE"
      ],
      "forbid": [
        "CWE-116"
      ]
    },
    {
      "id": "access-log-retention",
      "q": "개인정보처리시스템 접속기록은 최소 몇 년 보관해야 하고 근거 법령은?",
      "expect": [
        "제\\s*30\\s*조",
        "1년"
      ],
      "forbid": [
        "제\\s*26\\s*조"
      ]
    },
    {
      "id": "kev-deadline",
      "q": "KEV에 등재된 취약점 조치 기한은 어떤 지침에 근거하고 며칠이야?",
      "expect": [
        "BOD\\s*22-01|Binding\\s*Operational\\s*Directive\\s*22-01",
        "2주|14일"
      ]
    },
    {
      "id": "cef-header",
      "q": "CEF 로그 헤더에 출발지 IP가 들어가? 헤더 구조를 알려줘",
      "expect": [
        "Extension|확장"
      ],
      "forbid": [
        "헤더에\\s*출발지\\s*IP가\\s*들어갑"
      ]
    },
    {
      "id": "snort-gid-sid",
      "q": "Snort 알림의 [1:2100498:7]에서 각 숫자는 뭘 뜻해?",
      "expect": [
        "GID|Generator",
        "SID|Signature"
      ]
    },
    {
      "id": "epss-vpr",
      "q": "EPSS와 VPR 차이를 정확히 알려줘",
      "expect": [
        "30일|확률",
        "Tenable|우선순위"
      ]
    },
    {
      "id": "kisa-u01",
      "q": "리눅스 SSH root 원격 로그인 차단은 KISA 어떤 점검항목이야?",
      "expect": [
        "U-01"
      ]
    },
    {
      "id": "smalltalk-no-cloud",
      "q": "고마워 수고했어",
      "signals": {
        "internalMiss": false
      }
    },
    {
      "id": "miss-signal-works",
      "q": "대한민국 수도가 어디야?",
      "signals": {
        "internalMiss": true
      }
    },
    {
      "id": "webreport-asset-query",
      "q": "안전대부 웹서버 취약점 알려줘",
      "expect": [
        "IW-32|IW-20|IW-27|평문|디렉토리"
      ],
      "forbid": [
        "찾을 수 없|정보가 없"
      ]
    }
  ]
}
