{
  "name": "gijo-wiki",
  "version": "5.2.0",
  "description": "GIJO WIKI - 통합 보안 ERP & 스마트 아키텍처 스튜디오 & 로컬 LLM 위키",
  "main": "main.js",
  "author": "GIJO TECHNOLOGY",
  "license": "Commercial",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --publish never",
    "build:installer": "electron-builder --win nsis --publish never",
    "build:portable": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gijo.wiki",
    "productName": "GIJO WIKI",
    "artifactName": "GIJO-WIKI-Setup-v${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GIJO WIKI"
    }
  }
}